---
import Base from "../layouts/Base.astro";
---

<Base
  title="Configurator – HomeRacker"
  description="Plan a HomeRacker rack: set width, depth, height, levels, feet and panels, preview it in 3D, and copy the parts list."
  app
>
  <div class="bar">
    <div class="wrap bar-inner">
      <h1>Configurator</h1>
      <p>Set the frame, levels and panels. The parts list updates as you go, and the address bar is the saved rack.</p>
    </div>
  </div>
  <div id="configurator" class="app"></div>
</Base>

<script>
  import "../../../configurator/src/configurator.css";
  import { mountConfigurator } from "../../../configurator/src/app";

  const root = document.querySelector<HTMLElement>("#configurator");
  if (root) mountConfigurator(root);
</script>

<style>
  .bar {
    flex: 0 0 auto;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }

  .bar-inner {
    display: flex;
    align-items: baseline;
    gap: 1.2rem;
    min-height: 2.9rem;
    padding: 0.35rem 0;
    flex-wrap: wrap;
  }

  h1 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--accent);
  }

  p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .app {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .app :global(.cfg) {
    flex: 1;
    min-height: 0;
    height: auto;
    border-top: none;
  }

  @media (max-width: 1000px) {
    .app :global(.cfg) {
      min-height: 0;
    }
  }
</style>
